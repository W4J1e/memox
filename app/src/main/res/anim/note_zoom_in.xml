<?xml version="1.0" encoding="utf-8"?>
<!-- Editor opening: a gentle zoom-up + fade-in (Keep-style "放大铺满"). Window animation so the
     top/bottom bars scale uniformly with the content — no stiff per-bar distortion. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="250" />
    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="250" />
</set>
