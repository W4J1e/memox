<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/RelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:contentDescription="Toolbar"
            app:collapseContentDescription="ToolbarCollapse"
            app:navigationContentDescription="ToolbarNavigation"
            app:contentInsetStart="8dp"
            app:contentInsetEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- 常态栏：视图切换 / 排序，显示在头像左侧 -->
                <LinearLayout
                    android:id="@+id/HomeBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|end">

                    <ImageButton
                        android:id="@+id/HomeViewToggleButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/view"
                        android:tint="?attr/colorOnSurfaceVariant"
                        app:srcCompat="@drawable/view_grid" />

                    <ImageButton
                        android:id="@+id/HomeSortButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/notes_sorted_by"
                        android:tint="?attr/colorOnSurfaceVariant"
                        app:srcCompat="@drawable/sort_arrows" />
                </LinearLayout>

                <!-- 搜索栏：默认隐藏，首页下拉呼出 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/SearchPill"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:contentPaddingStart="16dp"
                    app:contentPaddingEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/SearchIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="8dp"
                            android:tint="?attr/colorOnSurfaceVariant"
                            app:srcCompat="@drawable/search"
                            tools:ignore="ContentDescription" />

                        <EditText
                            android:id="@+id/SearchEditText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/search_notes"
                            android:inputType="textFilter"
                            android:imeOptions="actionSearch"
                            android:singleLine="true"
                            android:paddingStart="0dp"
                            android:paddingEnd="8dp"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            tools:ignore="Autofill,LabelFor" />

                        <ImageButton
                            android:id="@+id/ViewToggleButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/view"
                            android:tint="?attr/colorOnSurfaceVariant"
                            app:srcCompat="@drawable/view_grid" />

                        <ImageButton
                            android:id="@+id/SortButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/notes_sorted_by"
                            android:tint="?attr/colorOnSurfaceVariant"
                            app:srcCompat="@drawable/sort_arrows" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ImageButton
                    android:id="@+id/AvatarButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings"
                    android:tint="?attr/colorOnSurfaceVariant"
                    app:srcCompat="@drawable/account_circle" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ActionMode"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_below="@id/Toolbar"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/close" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/NavHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ActionMode"
            app:defaultNavHost="true"
            app:navGraph="@navigation/navigation" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/TakeNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/take_note"
            android:tooltipText="@string/take_note"
            style="@style/FloatingActionButtonPrimary"
            app:srcCompat="@drawable/edit" />

        <!-- Dynamic-Island style sync status indicator: sits in the toolbar row,
             between the title and the labels/settings buttons. Its vertical center is
             nudged down (FrameLayout paddingTop) so it aligns with the title text and
             the right-side icons. Hidden by default. -->
        <FrameLayout
            android:id="@+id/SyncIsland"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_alignTop="@id/Toolbar"
            android:layout_alignBottom="@id/Toolbar"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:paddingTop="12dp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/sync_island_bg"
                android:elevation="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ProgressBar
                    android:id="@+id/SyncIslandSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorOnSurfaceInverse"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/SyncIslandDone"
                    android:src="@drawable/checked_circle"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:tint="?attr/colorOnSurfaceInverse"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/SyncIslandText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceInverse"
                    android:textSize="13sp"
                    android:maxWidth="@dimen/sync_island_max_width"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="正在同步……" />
            </LinearLayout>
        </FrameLayout>

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/NavView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
