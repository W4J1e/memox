<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Enable Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/onedriveSyncEnabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onedrive_sync_enabled"
            android:padding="8dp" />

        <!-- Sync Options (visible when enabled) -->
        <LinearLayout
            android:id="@+id/onedriveSyncOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Account status row: shows signed-in account or a Sign in button -->
            <TextView
                android:id="@+id/onedriveAccountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/onedrive_not_signed_in"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onedriveSignInButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_sign_in"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onedriveSignOutButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_sign_out"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Auto Sync -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/onedriveAutoSyncSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_auto_sync"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_auto_sync_hint"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="?android:attr/listDivider" />

            <!-- Status -->
            <TextView
                android:id="@+id/onedriveStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="4dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Last Sync -->
            <TextView
                android:id="@+id/onedriveLastSyncText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="4dp"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onedriveTestConnectionButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onedrive_test_connection"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onedriveSyncNowButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onedrive_sync_now"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onedriveUploadButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onedrive_upload"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onedriveDownloadButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onedrive_download"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
